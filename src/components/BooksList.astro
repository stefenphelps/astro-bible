---
import slugify from "slugify";
import {
  defaultTranslationId,
  translationMeta,
  type TranslationId,
} from "../content/translations";

interface Props {
  bible: Record<string, Record<string, Record<string, string>>>;
  translation?: TranslationId;
}

const { bible, translation = defaultTranslationId } = Astro.props;
const isDefaultTranslation = translation === defaultTranslationId;
const translationLabel =
  translationMeta.find(({ id }) => id === translation)?.label ??
  translation.toUpperCase();
---

<ol class="books">
  {
    Object.entries(bible).map(([bookName, chaptersObj]) => {
      const bookSlug = slugify(bookName, { lower: true });
      const bookHref = isDefaultTranslation
        ? `/${bookSlug}/`
        : `/${translation}/${bookSlug}/`;

      return (
        <li data-book-item data-book-slug={bookSlug}>
          <details>
            <summary>
              <span data-book-title>{bookName}</span>
            </summary>
            <div class="books-actions">
              <a data-astro-prefetch="viewport" data-book-link href={bookHref}>
                Read {bookName}
              </a>
              <span class="books-translation" data-book-translation>
                {translationLabel}
              </span>
            </div>
            <ol class="books-chapters">
              {Object.keys(chaptersObj).map((chapterNum) => (
                <li>
                  <a
                    data-book-chapter-link
                    data-chapter-num={chapterNum}
                    href={`${bookHref}#chapter-${chapterNum}`}
                  >
                    {chapterNum}
                  </a>
                </li>
              ))}
            </ol>
          </details>
        </li>
      );
    })
  }
</ol>

<style lang="scss">
  .books {
    list-style: none;
    margin: 0;
    padding: 0;
    text-align: center;

    > li {
      font-size: var(--step-5);
    }
  }

  details {
    padding: 0.5rem 0 0;
  }

  details[open] {
    padding-bottom: 1.5rem;
  }

  summary {
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .books-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin: 0.75rem 0 1rem;
    font-size: var(--step-0);
  }

  .books-translation {
    opacity: 0.7;
  }

  .books-chapters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    font-size: var(--step-0);

    a {
      border: 1px solid var(--text);
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2em;
      height: 2em;

      &:hover,
      &:focus {
        box-shadow: 0 0 0 transparent;
        background: var(--text);
        color: var(--bg);
      }
    }
  }
</style>

<script>
  import { defaultTranslationId, translationMeta } from "../content/translations";

  const books = document.querySelectorAll<HTMLElement>("[data-book-item]");
  const translationIds = translationMeta.map(({ id }) => id);
  const translationLabels = new Map(
    translationMeta.map(({ id, label }) => [id, label]),
  );
  const defaultLabel =
    translationLabels.get(defaultTranslationId) ?? defaultTranslationId.toUpperCase();

  const updateHomepageLinks = (translationId: string) => {
    const label = translationLabels.get(translationId) ?? translationId.toUpperCase();
    books.forEach((book) => {
      const bookSlug = book.dataset.bookSlug;
      const link = book.querySelector<HTMLAnchorElement>("[data-book-link]");
      const translation = book.querySelector<HTMLElement>("[data-book-translation]");
      const chapterLinks = book.querySelectorAll<HTMLAnchorElement>(
        "[data-book-chapter-link]",
      );

      if (!bookSlug || !link || !translation) {
        return;
      }

      const bookHref =
        translationId === defaultTranslationId
          ? `/${bookSlug}/`
          : `/${translationId}/${bookSlug}/`;

      link.href =
        bookHref;
      translation.textContent = label;
      chapterLinks.forEach((chapterLink) => {
        const chapterNum = chapterLink.dataset.chapterNum;
        if (!chapterNum) {
          return;
        }
        chapterLink.href = `${bookHref}#chapter-${chapterNum}`;
      });
    });
  };

  if (window.location.pathname === "/") {
    const storedTranslation = localStorage.getItem("translation");
    const homepageTranslation =
      storedTranslation && translationIds.includes(storedTranslation)
        ? storedTranslation
        : defaultTranslationId;

    if (homepageTranslation !== defaultTranslationId) {
      updateHomepageLinks(homepageTranslation);
    } else {
      books.forEach((book) => {
        const translation = book.querySelector<HTMLElement>("[data-book-translation]");
        if (translation) {
          translation.textContent = defaultLabel;
        }
      });
    }
  }
</script>
